esource_name)\n\n    # Return output\n    return ActionOutput(\n        resource_metadata={\n            \"resource_id\":resource.id,\n            \"resource_name\":resource.name\n        }\n        details={\n            \"status\": \"created\",\n            \"region\": \"us-east-1\",\n            \"created_at\": timestamp\n        }\n    )\n```\n\n## STDOUT Control\n\nUsers select what to print via `stdout_options` field in template.\n\n**Fallback behavior:** Empty list = print everything\n*Only if there is no controll fields in the template, otherwise an emplty list means print nothing*\n\n```python\ndef print_output(self):\n    print_all = len(self.stdout_options) == 0\n\n    # Always print basics\n    if self.resource_id:\n        print(f\"\\nResource ID: {self.resource_id}\")\n    if self.resource_name:\n        print(f\"Resource Name: {self.resource_name}\")\n\n    # Conditional printing based on user selection\n    if (print_all or \"details\" in self.stdout_options) and self.details:\n        print(\"\\n--- Details ---\")\n        for key, value in self.details.items():\n            print(f\"  {key}: {value}\")\n\n    if (print_all or \"items\" in self.stdout_options) and self.items:\n        print(f\"\\n--- Items ({len(self.items)}) ---\")\n        for i, item in enumerate(self.items, 1):\n            print(f\"  {i}. {item}\")\n\n    if (print_all or \"metadata\" in self.stdout_options) and self.metadata:\n        print(\"\\n--- Metadata ---\")\n        for key, value in self.metadata.items():\n            print(f\"  {key}: {value}\")\n```\n\n## Extension Output Control\n\nUsers select what goes in unv_output via `output_options` field in template.\n\n**Fallback behavior:** Empty list = include everything\n*Only if there is no controll fields in the template, otherwise an emplty list means print nothing*\n\n```python\ndef to_dict(self) -> Dict[str, Any]:\n    include_all = len(self.output_options) == 0\n    output = {}\n\n    # Always include basics\n    if self.resource_id:\n        output[\"resource_id\"] = self.resource_id\n    if self.resource_name:\n        output[\"resource_name\"] = self.resource_name\n\n    # Conditional inclusion based on user selection\n    if (include_all or \"details\" in self.output_options) and self.details:\n        output[\"details\"] = self.details\n\n    if (include_all or \"items\" in self.output_options) and self.items:\n        output[\"items\"] = self.items\n        output[\"item_count\"] = len(self.items)\n\n    if (include_all or \"metadata\" in self.output_options) and self.metadata:\n        output[\"metadata\"] = self.metadata\n\n    return output\n```\n\n## Field Customization\n\nDefine fields based on your extension's needs:\n\n```python\n@dataclass\nclass ActionOutput:\n    # Detailed information\n    details: Optional[Dict[str, Any]] = None\n    properties: Optional[Dict[str, Any]] = None\n\n    # Collections\n    items: Optional[List[Dict[str, Any]]] = None\n    warnings: Optional[List[str]] = None\n\n    # Metadata\n    metadata: Optional[Dict[str, Any]] = None\n    statistics: Optional[Dict[str, Any]] = None\n\n    # Control fields\n    stdout_options: List[str] = None\n    output_options: List[str] = None\n```\n\n## Template.json Integration\n\nControl fields defined in template.json:\n\n```json\n{\n  \"name\": \"stdout_options\",\n  \"type\": \"choice\",\n  \"label\": \"STDOUT Options\",\n  \"multiple_select\": true,\n  \"required\": false,\n  \"default\": [],\n  \"choices\": [\n    {\"label\": \"Details\", \"value\": \"details\"},\n    {\"label\": \"Items\", \"value\": \"items\"},\n    {\"label\": \"Metadata\", \"value\": \"metadata\"}\n  ]\n}\n```\n\nActions receive these from InputFields:\n\n```python\nreturn ActionOutput(\n    resource_id=resource.id,\n    details=details,\n    stdout_options=input_data.stdout_options,\n    output_options=input_data.output_options\n)\n```\n\n## __post_init__ Pattern\n\nInitialize control fields with fallback:\n\n```python\ndef __post_init__(self):\n    \"\"\"Initialize control fields.\"\"\"\n    if self.stdout_options is None:\n        self.stdout_options = []\n    if self.output_options is None:\n        self.output_options = []\n```\n\n## Complete Example\n\n```python\n@dataclass\nclass ActionOutput:\n    resource_id: Optional[str] = None\n    items: Optional[List[Dict]] = None\n    statistics: Optional[Dict] = None\n\n    stdout_options: List[str] = None\n    output_options: List[str] = None\n\n    def __post_init__(self):\n        if self.stdout_options is None:\n            self.stdout_options = []\n        if self.output_options is None:\n            self.output_options = []\n\n    def print_output(self):\n\n        if (\"items\" in self.stdout_options) and self.items:\n            print(f\"Items: {len(self.items)}\")\n            for item in self.items[:5]:  # Show first 5\n                print(f\"  - {item['name']}\")\n\n        if (\"statistics\" in self.stdout_options) and self.statistics:\n            print(\"\\nStatistics:\")\n            for key, val in self.statistics.items():\n                print(f\"  {key}: {val}\")\n\n    def to_dict(self) -> Dict[str, Any]:\n        include_all = len(self.output_options) == 0\n        output = {}\n\n        if self.resource_id:\n            output[\"resource_id\"] = self.resource_id\n\n        if (include_all or \"items\" in self.output_options) and self.items:\n            output[\"items\"] = self.items\n            output[\"item_count\"] = len(self.items)\n\n        if (include_all or \"statistics\" in self.output_options) and self.statistics:\n            output[\"statistics\"] = self.statistics\n\n        return output\n```\n\nSee src/actions/output.py for full implementation.","numLines":240,"startLine":1,"totalLines":240}},"tool_use_id":"toolu_012A3X6i9PFrDxa5ZNEWwEeZ","duration_ms":0}

